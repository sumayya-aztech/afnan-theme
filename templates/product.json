{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "scent_family": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-meta-line' %}"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-delivery' %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-trust' %}"
          }
        },
        "description_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Description",
            "icon": "none",
            "content": "<p>Celebrate confidence and strength with an exceptional fragrance for those who dare to be different. Embrace individuality and leave an ever-lasting impression with this powerful and bold scent.</p>",
            "page": ""
          }
        },
        "notes_tab": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-notes-tab', block_id: 'main' %}"
          }
        },
        "care_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fragrance Care & Storage",
            "icon": "none",
            "content": "<p>Keep your fragrance in a cool, dry place away from direct sunlight and extreme temperatures. Always close the bottle tightly when not in use.</p>",
            "page": ""
          }
        },
        "tips_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Tips for Best Experience",
            "icon": "none",
            "content": "<p>Layer with matching body products for enhanced effect, experiment with different application spots for day or evening wear, and rotate fragrances to keep your senses engaged.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "scent_family",
        "price",
        "variant_picker",
        "quantity_selector",
        "delivery",
        "buy_buttons",
        "trust",
        "description_tab",
        "notes_tab",
        "care_tab",
        "tips_tab"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "services": {
      "type": "multicolumn",
      "blocks": {
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Non toxic",
            "text": "<p>Phthalates and paraben free</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Free delivery",
            "text": "<p>On orders over AED 100</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-3": {
          "type": "column",
          "settings": {
            "title": "Secure payments",
            "text": "<p>Safe and encrypted checkout</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column-1",
        "column-2",
        "column-3"
      ],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "third",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "center",
        "background_style": "none",
        "button_label": "",
        "button_link": "",
        "color_scheme": "scheme-1",
        "columns_mobile": "1",
        "swipe_on_mobile": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "notes": {
      "type": "product-notes",
      "settings": {}
    },
    "story": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "A bold signature",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Redefined for you",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>A fragrance that empowers you to own every moment. Worn with confidence, it leaves an unforgettable statement wherever you go.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "caption",
        "heading",
        "text"
      ],
      "settings": {
        "height": "medium",
        "desktop_image_width": "medium",
        "layout": "image_first",
        "image_behavior": "none",
        "content_layout": "no-overlap",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-4",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Goes well with",
        "heading_size": "h2",
        "products_to_show": 5,
        "columns_desktop": 5,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 48,
        "padding_bottom": 36
      }
    },
    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the refund policy?",
            "icon": "none",
            "row_content": "<p>Unopened items can be returned within 14 days of delivery for a refund to the original payment method.</p>",
            "page": ""
          }
        },
        "row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does it take until I get my order?",
            "icon": "none",
            "row_content": "<p>Orders within the UAE are delivered in 1 to 2 working days.</p>",
            "page": ""
          }
        },
        "row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do we ship internationally?",
            "icon": "none",
            "row_content": "<p>Yes, we ship to selected countries. Delivery options are shown at checkout.</p>",
            "page": ""
          }
        },
        "row-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will I receive tracking info?",
            "icon": "none",
            "row_content": "<p>Yes. A tracking link is emailed as soon as your order ships.</p>",
            "page": ""
          }
        },
        "row-5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I have a complaint about my order. What's next?",
            "icon": "none",
            "row_content": "<p>Contact our customer service team and we will resolve it quickly.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "row-1",
        "row-2",
        "row-3",
        "row-4",
        "row-5"
      ],
      "settings": {
        "caption": "",
        "heading": "Frequently asked questions",
        "heading_size": "h2",
        "heading_alignment": "center",
        "layout": "none",
        "container_color_scheme": "scheme-2",
        "color_scheme": "scheme-2",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "main",
    "services",
    "notes",
    "story",
    "related-products",
    "faq"
  ]
}
