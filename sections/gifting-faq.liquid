{%- comment -%}
  FAQ accordion built on <details>/<summary> (no JavaScript, keyboard accessible).
  With no blocks it shows the translated default questions (locales: gifting.faq.*),
  so it works in English and Arabic out of the box. Add blocks to override.
{%- endcomment -%}
{{ 'gifting.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gifting.faq.heading' | t
  endif
-%}

<div class="gifting-faq color-{{ section.settings.color_scheme }} gradient" {{ section.shopify_attributes }}>
  <div class="page-width gifting-faq__inner">
    <h2 class="title">{{ heading | escape }}</h2>
    <div class="gifting-faq__list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <details class="gifting-faq__item" {{ block.shopify_attributes }}>
            <summary class="gifting-faq__question">{{ block.settings.question | escape }}</summary>
            <div class="gifting-faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..5) -%}
          {%- capture question_key %}gifting.faq.q{{ index }}{% endcapture -%}
          {%- capture answer_key %}gifting.faq.a{{ index }}{% endcapture -%}
          <details class="gifting-faq__item">
            <summary class="gifting-faq__question">{{ question_key | t }}</summary>
            <div class="gifting-faq__answer rte"><p>{{ answer_key | t }}</p></div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gifting FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the built-in English/Arabic text. With no questions added, default gifting questions are shown."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gifting FAQ"
    }
  ]
}
{% endschema %}
