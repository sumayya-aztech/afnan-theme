{%- comment -%}
  Build-your-own gift box.
  The customer picks exactly 3 perfumes. They are added to the cart as ONE line item: the "Gift Box"
  product (set box price) with the three picks stored as line item properties, so the warehouse
  sees them on the order and packing slip.

  Perfumes shown: every product with the tag in section settings (default "Perfume") that has a
  purchasable variant. The variant used in the box is the one whose first option matches
  "Variant used in the box" (default "50 ML"), else the first available variant.
{%- endcomment -%}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'gifting.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-box.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign box_product = section.settings.box_product
  if box_product == blank
    assign box_product = all_products['gift-box']
  endif
  assign box_variant = box_product.selected_or_first_available_variant
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gift_box.heading' | t
  endif
  assign intro = section.settings.text
  if intro == blank
    assign intro = 'gift_box.text' | t
  endif
  assign size = section.settings.variant_size
  assign pick_tag = section.settings.perfume_tag
  assign pick_limit = 3
-%}

<div id="build-your-own-box" class="gift-box color-{{ section.settings.color_scheme }} gradient" {{ section.shopify_attributes }}>
  <div class="page-width">
    <h2 class="title">{{ heading | escape }}</h2>
    <p class="gift-box__intro">{{ intro | escape }}</p>

    {%- if box_variant == blank -%}
      <p class="gift-box__notice" role="alert">{{ 'gift_box.not_configured' | t }}</p>
    {%- else -%}
      <gift-box-builder
        class="gift-box__builder"
        data-limit="{{ pick_limit }}"
        data-box-variant="{{ box_variant.id }}"
        data-box-price="{{ box_variant.price }}"
        data-currency="{{ cart.currency.iso_code }}"
        data-money-format="{{ shop.money_format | escape }}"
        data-cart-url="{{ routes.cart_url }}"
        data-add-url="{{ routes.cart_add_url }}"
        data-error="{{ 'gift_box.error' | t | escape }}"
        data-pick-label="{{ 'gift_box.pick_label' | t | escape }}"
      >
        <div class="gift-box__layout">
          <ul class="gift-box__grid" role="list">
            {%- for product in collections.all.products -%}
              {%- if product.tags contains pick_tag -%}
                {%- liquid
                  assign pick = false
                  for variant in product.variants
                    if variant.available and variant.option1 == size
                      assign pick = variant
                      break
                    endif
                  endfor
                  if pick == false
                    for variant in product.variants
                      if variant.available
                        assign pick = variant
                        break
                      endif
                    endfor
                  endif
                -%}
                <li class="gift-box__item">
                  <label class="gift-box__card{% if pick == false %} is-sold-out{% endif %}">
                    <input
                      type="checkbox"
                      class="gift-box__input"
                      value="{{ product.id }}"
                      {% if pick != false %}
                        data-variant-id="{{ pick.id }}"
                        data-title="{{ product.title | escape }}"
                        data-variant-title="{{ pick.title | escape }}"
                        data-sku="{{ pick.sku | escape }}"
                        data-price="{{ pick.price }}"
                        data-image="{{ product.featured_image | image_url: width: 160 }}"
                      {% else %}
                        disabled
                      {% endif %}
                    >
                    <span class="gift-box__media">
                      {%- if product.featured_image != blank -%}
                        {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '200, 300, 400' }}
                      {%- endif -%}
                      <span class="gift-box__check" aria-hidden="true"></span>
                    </span>
                    <span class="gift-box__title">{{ product.title | escape }}</span>
                    <span class="gift-box__price">
                      {%- if pick != false -%}
                        {{ pick.title | escape }} &middot; {{ pick.price | money }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </label>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <aside class="gift-box__summary" aria-live="polite">
            <h3 class="gift-box__summary-title">{{ 'gift_box.your_box' | t }}</h3>
            <p class="gift-box__counter">
              <span data-count>0</span> / {{ pick_limit }} {{ 'gift_box.selected' | t }}
            </p>
            <ol class="gift-box__slots" data-slots>
              {%- for i in (1..pick_limit) -%}
                <li class="gift-box__slot" data-slot>
                  <span class="gift-box__slot-label">{{ 'gift_box.pick_label' | t }} {{ i }}</span>
                </li>
              {%- endfor -%}
            </ol>
            <dl class="gift-box__totals">
              <div>
                <dt>{{ 'gift_box.box_price' | t }}</dt>
                <dd>{{ box_variant.price | money }}</dd>
              </div>
              <div class="gift-box__savings" data-savings hidden>
                <dt>{{ 'gift_box.you_save' | t }}</dt>
                <dd data-savings-value></dd>
              </div>
            </dl>
            <button type="button" class="button button--full-width" data-add disabled>
              {{ 'gift_box.add' | t }}
            </button>
            <p class="gift-box__message" role="alert" data-message hidden></p>
          </aside>
        </div>
      </gift-box-builder>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Gift box builder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "box_product",
      "label": "Gift box product",
      "info": "The product that carries the box price. Defaults to the product with handle gift-box."
    },
    {
      "type": "text",
      "id": "perfume_tag",
      "label": "Perfume tag",
      "default": "Perfume",
      "info": "Products with this tag can be picked for the box."
    },
    {
      "type": "text",
      "id": "variant_size",
      "label": "Variant used in the box",
      "default": "50 ML",
      "info": "First option value to use, for example 50 ML. Falls back to the first available variant."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave text fields blank to use the built-in English/Arabic text."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Gift box builder"
    }
  ]
}
{% endschema %}
