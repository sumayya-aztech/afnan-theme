{%- comment -%}
  Sitewide Ramadan banner. Controlled from Theme settings > Ramadan mode; renders nothing when off.
{%- endcomment -%}
{%- if settings.ramadan_enabled -%}
  {%- liquid
    assign banner_heading = settings.ramadan_banner_heading
    if banner_heading == blank
      assign banner_heading = 'ramadan.banner.heading' | t
    endif
    assign banner_text = settings.ramadan_banner_text
    if banner_text == blank
      assign banner_text = 'ramadan.banner.text' | t
    endif
    assign banner_button = settings.ramadan_banner_button_label
    if banner_button == blank
      assign banner_button = 'ramadan.banner.button' | t
    endif
    assign banner_link = settings.ramadan_banner_link | default: collections['gift-sets'].url | default: routes.all_products_collection_url
  -%}
  <section class="ramadan-banner" aria-label="{{ banner_heading | escape }}">
    {%- if settings.ramadan_banner_image != blank -%}
      <div class="ramadan-banner__media">
        {{ settings.ramadan_banner_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: '' }}
      </div>
    {%- endif -%}
    <div class="ramadan-banner__inner page-width">
      <p class="ramadan-banner__eyebrow" aria-hidden="true">&#9790;</p>
      <h2 class="ramadan-banner__heading h1">{{ banner_heading | escape }}</h2>
      <p class="ramadan-banner__text">{{ banner_text | escape }}</p>
      <a href="{{ banner_link }}" class="ramadan-banner__button button">{{ banner_button | escape }}</a>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Ramadan banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "Content and visibility are managed in Theme settings > Ramadan mode."
    }
  ]
}
{% endschema %}
