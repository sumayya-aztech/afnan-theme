{%- comment -%}
  "Notes" accordion tab using the same markup as the theme's collapsible tabs.
  Reads product metafields custom.top_notes / middle_notes / base_notes (list of single line text,
  or comma separated text). Renders nothing when none are filled in.
  Params: block_id (string) for unique ids.
{%- endcomment -%}
{%- liquid
  assign top_source = product.metafields.custom.top_notes.value
  if top_source == blank
    assign top_source = product.metafields.custom.custom_top_notes.value
  endif
  assign top_notes = top_source | join: ', '
  assign middle_notes = product.metafields.custom.middle_notes.value | join: ', '
  assign base_notes = product.metafields.custom.base_notes.value | join: ', '
-%}
{%- if top_notes != blank or middle_notes != blank or base_notes != blank -%}
  <div class="product__accordion accordion quick-add-hidden">
    <details id="Details-notes-{{ block_id }}">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">{{ 'product_page.notes.tab' | t }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte">
        <p class="pdp-notes-line"><strong>{{ 'product_page.notes.top' | t }}:</strong> {{ top_notes | escape }}</p>
        <p class="pdp-notes-line"><strong>{{ 'product_page.notes.middle' | t }}:</strong> {{ middle_notes | escape }}</p>
        <p class="pdp-notes-line"><strong>{{ 'product_page.notes.base' | t }}:</strong> {{ base_notes | escape }}</p>
      </div>
    </details>
  </div>
{%- endif -%}
