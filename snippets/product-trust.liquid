{%- comment -%} Three reassurance icons under the buy buttons. {%- endcomment -%}
<ul class="pdp-trust" role="list">
  <li class="pdp-trust__item">
    <svg class="pdp-trust__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    </svg>
    <span>{{ 'product_page.trust.craftsmanship' | t }}</span>
