{%- comment -%}
  Product page message for products in the free-gift collection (default: femme-collection).
  Text: "You've unlocked a free gift". Renders nothing for other products or when the offer is off.
{%- endcomment -%}
{%- liquid
  assign qualifying = settings.gwp_collection
  if qualifying == blank
    assign qualifying = collections['femme-collection']
  endif

  assign gift_product = settings.gwp_product
  if gift_product == blank
    assign gift_product = all_products['free-gift-mini-perfume']
  endif

  assign is_qualifying = false
  for collection_item in product.collections
    if collection_item.handle == qualifying.handle
      assign is_qualifying = true
    endif
  endfor
-%}
{%- if settings.gwp_enabled and is_qualifying and gift_product != blank -%}
  {{ 'gwp.css' | asset_url | stylesheet_tag }}
  <div class="gwp-product" role="note">
    <svg class="gwp-product__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="8" width="18" height="4" rx="1"/>
      <path d="M12 8v13M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"/>
      <path d="M7.5 8a2.5 2.5 0 1 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 1 1 0 5"/>
    </svg>
    <div>
      <p class="gwp-product__title">{{ 'gwp.unlocked_title' | t }}</p>
      <p class="gwp-product__text">{{ 'gwp.product_text' | t: gift: gift_product.title }}</p>
    </div>
  </div>
{%- endif -%}
